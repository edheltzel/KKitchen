---
import { PERSON_LABEL, PEOPLE, RATINGS, RATING_LABEL } from '../scripts/ratings';
import { confirmedTags, exampleTitle, type ExampleRecipe } from '../data/examples';

interface Props {
  recipe: ExampleRecipe;
}

const { recipe } = Astro.props;
const tags = confirmedTags(recipe);
---

<article class="card kk-card overflow-hidden rounded-2xl border border-base-300 bg-kk-card shadow-sm" data-example
  data-id={recipe.id}
  data-name={recipe.name}
  data-ingredients={recipe.ingredients.join('|')}
  data-meal={recipe.meal}
  data-minutes={recipe.minutes}
  data-diet={tags.join('|')}
>
  <div class="relative">
    <div class="kk-tile relative aspect-[4/3]" aria-hidden="true">
      <span class="kk-tile-letter">{recipe.name.charAt(0)}</span>
    </div>
    <span data-role="family-badge" hidden class="kk-fav-badge">★ Family favorite</span>
  </div>
  <span class="badge absolute right-2 top-2 border-0 bg-base-content font-bold text-base-100">Example</span>
  <div class="card-body gap-1 p-3">
    <h2 class="card-title text-[15px] leading-tight">{exampleTitle(recipe)}</h2>
    <p class="font-mono text-[13px] text-kk-muted">{recipe.minutes} min{tags.length > 0 && ` · ${tags.join(', ')}`}</p>
    <div class="kk-rate" role="group" aria-label={`Ratings for ${exampleTitle(recipe)}`}>
      <div class="kk-rate-status">
        {PEOPLE.map((person) => <p data-person={person}>{PERSON_LABEL[person]}: not rated yet</p>)}
      </div>
      <div class="kk-rate-buttons">
        {RATINGS.map((rating) => (
          <button type="button" class="kk-rate-btn" data-rating={rating} aria-pressed="false">{RATING_LABEL[rating]}</button>
        ))}
      </div>
    </div>
    <div class="kk-plan">
      <p data-role="plan-status" hidden class="kk-plan-status"></p>
      <button type="button" class="kk-plan-btn" data-role="plan" aria-label={`Plan ${exampleTitle(recipe)} for a day`}>Plan</button>
    </div>
  </div>
</article>
