---
// "I'm Ed / I'm Kristina": which person this phone is. Wired by ratings-ui.ts.
---

<fieldset id="me-picker" class="mt-3 flex flex-wrap items-center gap-2 border-0 p-0">
  <legend class="sr-only">Which person is this phone?</legend>
  <button type="button" class="kk-chip" aria-pressed="false" data-me="ed">I'm Ed</button>
  <button type="button" class="kk-chip" aria-pressed="false" data-me="kristina">I'm Kristina</button>
  <p id="me-hint" class="text-[13px] text-kk-muted">Pick who you are to start rating.</p>
</fieldset>
