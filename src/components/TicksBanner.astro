---
// "Checks can't be saved": ingredient ticks only last until the page closes. Wired by recipe-page.ts. Put inside <Banners>.

export const prerender = true;
---

<div id="ticks-unavailable" role="alert" hidden class="kk-notice mb-2 flex items-center justify-between gap-3 rounded-2xl px-4 py-2">
  <p class="text-[15px] font-bold">Can't save your checks on this phone. They last until you close this page.</p>
  <button type="button" id="ticks-retry" class="btn btn-primary min-h-11 rounded-full px-5">Retry</button>
</div>
