---
// The two status lines and the Loved it / Not for us buttons. ratings-ui.ts draws and wires them, on a card and on the recipe page.
import { PERSON_LABEL, PEOPLE, RATINGS, RATING_LABEL } from '../scripts/ratings';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="kk-rate" role="group" aria-label={`Ratings for ${title}`}>
  <div class="kk-rate-status">
    {PEOPLE.map((person) => <p data-person={person}>{PERSON_LABEL[person]}: not rated yet</p>)}
  </div>
  <div class="kk-rate-buttons">
    {RATINGS.map((rating) => (
      <button type="button" class="kk-rate-btn" data-rating={rating} aria-pressed="false">{RATING_LABEL[rating]}</button>
    ))}
  </div>
</div>
