---
---

<form id="search-form" role="search" class="px-4 pt-3 pb-2 bg-base-100" novalidate>
  <div
    class="kk-search flex h-14 items-center gap-2 rounded-full border border-base-300 bg-kk-card pl-4 pr-1.5 shadow-sm"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false" class="shrink-0 text-kk-muted">
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4 4" />
    </svg>
    <input
      id="search-input"
      type="search"
      name="q"
      aria-label="Search recipes"
      placeholder="Search names, ingredients"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      class="kk-search-input min-h-11 min-w-0 flex-1 bg-transparent text-[16px] outline-none placeholder:text-kk-muted"
    />
    <button
      type="button"
      id="filters-button"
      aria-haspopup="dialog"
      class="inline-flex h-11 min-w-11 shrink-0 items-center gap-1.5 rounded-full bg-base-content px-4 text-[15px] font-bold text-base-100"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
        <circle cx="15" cy="7" r="2" />
        <circle cx="9" cy="17" r="2" />
      </svg>
      Filters
      <span id="filters-count" hidden class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-primary px-1.5 text-[13px] font-bold text-primary-content">0</span>
    </button>
  </div>
</form>

<script>
  import '../scripts/keyboard-lift';
</script>
