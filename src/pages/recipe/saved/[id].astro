---
import { env } from 'cloudflare:workers';
import RecipeView from '../../../components/RecipeView.astro';
import { recipesFor } from '../../../lib/live-recipes';

export const prerender = false;

// A recipe saved from the form after the build. The known recipes keep their prerendered pages.
const recipes = await recipesFor(env.RECIPES);
const recipe = recipes.find((item) => item.id === Astro.params.id);
if (!recipe) return new Response(null, { status: 404 });
const catalog = recipes.map((item) => ({ id: item.id, name: item.name }));
---

<RecipeView recipe={recipe} catalog={catalog} />

<script>
  import '../../../scripts/recipe-page';
</script>
