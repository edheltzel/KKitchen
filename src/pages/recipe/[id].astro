---
import RecipeView from '../../components/RecipeView.astro';
import { exampleRecipes } from '../../data/examples';
// The build emits a page per known recipe, which the tests read. A recipe saved after the build is served at
// /recipe/saved/[id], which reads the store.
export const prerender = true;

export function getStaticPaths() {
  return exampleRecipes.map((recipe) => ({ params: { id: recipe.id } }));
}

const recipes = exampleRecipes;
const recipe = recipes.find((item) => item.id === Astro.params.id);
if (!recipe) return new Response(null, { status: 404 });
const catalog = recipes.map((r) => ({ id: r.id, name: r.name }));
---

<RecipeView recipe={recipe} catalog={catalog} />

<script>
  import '../../scripts/recipe-page';
</script>
