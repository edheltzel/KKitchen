---
import Base from '../../layouts/Base.astro';

export const prerender = false;

const meals = ['breakfast', 'lunch', 'dinner', 'snack'];
---

<Base title="New recipe · Kris's Kitchen" active="recipes">
  <a href="/" class="kk-back">Recipes</a>
  <h1 class="mt-1 text-3xl font-extrabold tracking-tight">New recipe</h1>
  <div class="kk-form-layout mt-4 lg:grid lg:grid-cols-2 lg:gap-8">
  <form method="post" action="/api/recipes" enctype="multipart/form-data" class="kk-form grid gap-4">
    <label class="grid gap-1">
      <span class="text-[13px] font-bold">Name</span>
      <input name="name" required class="input input-bordered h-12 w-full" />
    </label>
    <label class="grid gap-1">
      <span class="text-[13px] font-bold">Id</span>
      <input name="id" required pattern="[a-z0-9]+(-[a-z0-9]+)*" class="input input-bordered h-12 w-full" />
    </label>
    <div class="grid grid-cols-2 gap-3">
      <label class="grid gap-1">
        <span class="text-[13px] font-bold">Meal</span>
        <select name="meal" class="select select-bordered h-12 w-full">
          {meals.map((meal) => <option value={meal}>{meal}</option>)}
        </select>
      </label>
      <label class="grid gap-1">
        <span class="text-[13px] font-bold">Minutes</span>
        <input name="minutes" type="number" min="0" value="30" class="input input-bordered h-12 w-full" />
      </label>
    </div>
    <label class="grid gap-1">
      <span class="text-[13px] font-bold">Ingredients, one per line</span>
      <textarea name="ingredients" required rows="6" class="textarea textarea-bordered w-full"></textarea>
    </label>
    <label class="grid gap-1">
      <span class="text-[13px] font-bold">Method, one step per line</span>
      <textarea name="method" required rows="8" class="textarea textarea-bordered w-full"></textarea>
    </label>
    <label class="grid gap-1">
      <span class="text-[13px] font-bold">Photo, optional</span>
      <input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" class="kk-file w-full" />
    </label>
    <button class="btn btn-primary h-12 min-h-11 rounded-full">Save recipe</button>
  </form>
  <aside class="kk-preview">
    <h2 class="text-xl font-extrabold">Preview</h2>
    <p id="preview-name" class="mt-2 text-2xl font-extrabold">New recipe</p>
    <ul id="preview-ingredients" class="mt-3 list-disc pl-5"></ul>
    <ol id="preview-method" class="mt-3 list-decimal pl-5"></ol>
  </aside>
  </div>
</Base>

<script>
  const form = document.querySelector('form')!;
  const fill = (id: string, lines: string[]) => {
    const list = document.querySelector(id)!;
    list.replaceChildren(...lines.filter(Boolean).map((line) => {
      const item = document.createElement('li');
      item.textContent = line;
      return item;
    }));
  };
  form.addEventListener('input', () => {
    const data = new FormData(form);
    document.querySelector('#preview-name')!.textContent = String(data.get('name') || 'New recipe');
    fill('#preview-ingredients', String(data.get('ingredients') ?? '').split('\n'));
    fill('#preview-method', String(data.get('method') ?? '').split('\n'));
  });
</script>
