---
import Base from '../../layouts/Base.astro';
import Banners from '../../components/Banners.astro';
import TicksBanner from '../../components/TicksBanner.astro';
import MePicker from '../../components/MePicker.astro';
import RatingBlock from '../../components/RatingBlock.astro';
import UndoBar from '../../components/UndoBar.astro';
import { jsonForScript } from '../../scripts/json-script';
import { exampleRecipes, exampleTitle, flatItems, type ExampleRecipe } from '../../data/examples';

export function getStaticPaths() {
  // Same rule as the recipe page: only approved recipes get a route.
  return exampleRecipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

interface Props {
  recipe: ExampleRecipe;
}

const { recipe } = Astro.props;
const title = exampleTitle(recipe);
const items = flatItems(recipe);
const total = recipe.steps.length;
// What the script needs to draw a step: its text, the ingredient ids it marks, and every ingredient's text by id.
const cookData = {
  steps: recipe.steps.map((s) => ({ text: s.text, uses: s.uses ?? [] })),
  items: Object.fromEntries(items.map((i) => [i.id, i.text])),
};
---

<Base title={`Cooking ${title} · Kris's Kitchen`} bare>
  <article id="cook" data-id={recipe.id} data-name={recipe.name} data-total={total} class="kk-cook-wrap">
    <header class="kk-cook-top">
      <a id="exit" href={`/recipe/${recipe.id}/`} class="kk-exit">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
        Exit<span class="sr-only"> cooking mode</span>
      </a>
      <p id="wake-status" class="kk-wake" role="status" data-status="off" hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <span id="wake-text">Screen stays on</span>
      </p>
    </header>

    <ol id="cook-progress" class="kk-progress" aria-label={`Progress through ${title}`}>
      {recipe.steps.map((_, i) => <li class="kk-seg" data-state="todo" aria-label={`Step ${i + 1} of ${total}: to do`}></li>)}
    </ol>

    <div id="wake-banner" role="alert" hidden class="kk-wake-banner">
      <p>Couldn't keep the screen on. Set Auto-Lock to Never in Settings.</p>
      <button type="button" id="wake-dismiss" class="kk-wake-dismiss">Got it</button>
    </div>

    <section id="screen-gather" class="kk-cook-screen" aria-labelledby="gather-title">
      <h2 id="gather-title" tabindex="-1" class="kk-cook-title">Gather</h2>
      <p id="ready-count" class="kk-ready" aria-live="polite">0 of {items.length} ready · tap a row</p>
      {recipe.groups.map((group) => (
        <div class="mt-2">
          {group.title && <h3 class="mt-3 text-[13px] font-bold uppercase tracking-wide text-kk-muted">{group.title}</h3>}
          <ul class="kk-ticks kk-ticks-big" aria-label={group.title ?? 'Ingredients'}>
            {group.items.map((item) => (
              <li>
                <label class="kk-tick">
                  <input type="checkbox" class="kk-tick-box" data-item={item.id} />
                  <span>{item.text}</span>
                </label>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="kk-cook-actions">
        <button type="button" id="start" class="btn btn-primary kk-cook-main">Start step 1 <span aria-hidden="true">→</span></button>
      </div>
    </section>

    <section id="screen-step" class="kk-cook-screen" aria-labelledby="step-heading" hidden>
      <h2 id="step-heading" tabindex="-1" class="kk-step-label">Step 1 of {total}</h2>
      <p id="step-text" class="kk-step-text" aria-live="polite"></p>
      <div id="use-now-wrap" hidden>
        <h3 class="kk-use-label">Use now</h3>
        <ul id="use-now" class="kk-ticks kk-ticks-big"></ul>
      </div>
      <div class="kk-cook-actions">
        <p class="kk-zone-hint">Tap the right side of the screen to go forward</p>
        <div class="kk-cook-buttons">
          <button type="button" id="back-step" class="kk-cook-back">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
            Back
          </button>
          <button type="button" id="next" class="btn btn-primary kk-cook-main">Next step <span aria-hidden="true">→</span></button>
        </div>
      </div>
    </section>

    <section id="screen-done" class="kk-cook-screen kk-cook-done" aria-labelledby="done-title" hidden>
      <div class="kk-done-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
      </div>
      <h2 id="done-title" tabindex="-1" class="kk-cook-title text-center">Dinner's ready</h2>
      <p class="kk-done-note">Ingredient checks are cleared for next time.</p>
      <span data-role="family-badge" hidden class="kk-fav-badge kk-fav-badge-flow">★ Family favorite</span>
      <h3 class="kk-how">How was it?</h3>
      <div class="kk-cook-rate" role="group" aria-label={`Rate ${title}`}>
        <RatingBlock title={title} part="buttons" />
      </div>
      <RatingBlock title={title} part="status" />
      <MePicker />
      <div class="kk-cook-actions">
        <a id="back-to-recipes" href="/" class="kk-cook-back kk-cook-wide">Back to recipes</a>
      </div>
    </section>
  </article>
  <script id="cook-data" type="application/json" set:html={jsonForScript(cookData)} />
  <Banners slot="above"><TicksBanner /></Banners>
  <UndoBar slot="replaces-tabs" />
</Base>

<script>
  import '../../scripts/cook-page';
</script>
