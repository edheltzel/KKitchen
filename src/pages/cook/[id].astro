---
import CookView from '../../components/CookView.astro';
import { exampleRecipes } from '../../data/examples';

export const prerender = true;

export function getStaticPaths() {
  return exampleRecipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
if (!recipe) return new Response(null, { status: 404 });
---

<CookView recipe={recipe} />

<script>
  import '../../scripts/cook-page';
</script>
