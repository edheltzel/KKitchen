---
import Base from '../layouts/Base.astro';
import { exampleRecipes, exampleTitle, isFixture } from '../data/examples';

const labels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---

<Base title="Week · Kris's Kitchen" active="week">
  <header class="flex items-baseline justify-between gap-3">
    <h1 class="text-3xl font-extrabold tracking-tight">This week</h1>
    <p id="week-range" class="text-[13px] font-semibold text-kk-muted"></p>
  </header>
  {isFixture && <p class="mt-1 text-[13px] text-kk-muted">Example recipes only: placeholder content, not real recipes.</p>}
  <ul id="week-list" class="kk-week mt-3">
    {labels.map((label, i) => (
      <li class="kk-week-row" data-slot={i}>
        <span class="kk-week-day">{label}</span>
        <div class="kk-week-cell"></div>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-center text-[13px] text-kk-muted">Remove on every dinner. Swipe left works too.</p>
  <p id="week-live" class="sr-only" aria-live="polite"></p>
  <dialog id="add-sheet" class="modal modal-bottom" aria-labelledby="add-title">
    <div class="modal-box mx-auto max-w-md rounded-t-3xl bg-base-100 p-0">
      <h2 id="add-title" class="px-5 pt-4 text-xl font-extrabold">Add a dinner</h2>
      <ul class="mt-2 px-3">
        {exampleRecipes.map((recipe) => (
          <li>
            <button type="button" class="kk-sheet-row" data-id={recipe.id} data-name={recipe.name}>
              <span class="font-bold">{exampleTitle(recipe)}</span>
              <span class="kk-sheet-status text-[13px] text-kk-muted" data-role="where"></span>
            </button>
          </li>
        ))}
      </ul>
      <form method="dialog" class="mt-2 border-t border-base-300 bg-base-100 px-5 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
        <button class="btn btn-block h-12 min-h-11 rounded-full text-base">Cancel</button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button aria-label="Close">close</button>
    </form>
  </dialog>
  <div slot="above" class="px-4">
    <div id="week-unavailable" role="alert" hidden class="kk-notice mb-2 flex items-center justify-between gap-3 rounded-2xl px-4 py-2">
      <p class="text-[15px] font-bold">Week plan unavailable. Your changes will save when you tap Retry.</p>
      <button type="button" id="week-retry" class="btn btn-primary min-h-11 rounded-full px-5">Retry</button>
    </div>
  </div>
  <div id="undo-bar" slot="replaces-tabs" role="status" hidden class="kk-undo-bar flex items-center justify-between gap-3">
    <p id="undo-text" class="text-[15px] font-bold"></p>
    <button type="button" id="undo-button" class="btn btn-primary min-h-11 rounded-full px-5">Undo</button>
  </div>
</Base>

<script>
  import '../scripts/week-page';
</script>
